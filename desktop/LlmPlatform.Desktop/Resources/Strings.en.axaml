<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
  <sys:String x:Key="AppTitle">Local AI Platform</sys:String>
  <sys:String x:Key="TrayChat">Chat</sys:String>
  <sys:String x:Key="TraySettings">Settings</sys:String>
  <sys:String x:Key="TrayExit">Exit</sys:String>

  <sys:String x:Key="Send">Send</sys:String>
  <sys:String x:Key="InputPlaceholder">Type a message. Enter to send, Ctrl/Shift+Enter for a new line</sys:String>
  <sys:String x:Key="EditMessage">Edit</sys:String>
  <sys:String x:Key="RetractMessage">Retract</sys:String>
  <sys:String x:Key="ChatFailed">Request failed. Please try again.</sys:String>
  <sys:String x:Key="ChatFailedLocal">Request failed. Import and start a local model first.</sys:String>
  <sys:String x:Key="ChatFailedRemote">Request failed. Check the remote configuration and network.</sys:String>
  <sys:String x:Key="ChatFailedRemoteKey">Request failed. Check the remote API key.</sys:String>
  <sys:String x:Key="ChatFailedNetwork">Request failed. Enable AI network access first.</sys:String>
  <sys:String x:Key="StatusGenerating">Generating…</sys:String>
  <sys:String x:Key="Sessions">Sessions</sys:String>
  <sys:String x:Key="NewSession">New session</sys:String>
  <sys:String x:Key="DeleteSession">Delete session</sys:String>
  <sys:String x:Key="UntitledSession">Untitled session</sys:String>

  <sys:String x:Key="ServerStarting">Starting local server…</sys:String>
  <sys:String x:Key="ServerReady">Local server is ready</sys:String>
  <sys:String x:Key="ServerFailed">Unable to start local server</sys:String>

  <sys:String x:Key="TabGeneral">General</sys:String>
  <sys:String x:Key="TabModels">Models</sys:String>
  <sys:String x:Key="TabMonitor">Monitor</sys:String>
  <sys:String x:Key="TabCapabilities">Capabilities</sys:String>
  <sys:String x:Key="TabData">Data</sys:String>
  <sys:String x:Key="TabPlugins">Plugins</sys:String>

  <sys:String x:Key="Language">Language</sys:String>
  <sys:String x:Key="LanguageDesc">Language used by the interface and new messages</sys:String>
  <sys:String x:Key="LanguageChinese">中文</sys:String>
  <sys:String x:Key="LanguageEnglish">English</sys:String>
  <sys:String x:Key="Theme">Theme</sys:String>
  <sys:String x:Key="ThemeDesc">Light, dark, or follow the system setting</sys:String>
  <sys:String x:Key="ThemeLight">Light</sys:String>
  <sys:String x:Key="ThemeDark">Dark</sys:String>
  <sys:String x:Key="ThemeSystem">System</sys:String>
  <sys:String x:Key="Network">Allow AI network access</sys:String>
  <sys:String x:Key="NetworkDesc">When off, inference and retrieval stay on this device</sys:String>
  <sys:String x:Key="Refresh">Refresh</sys:String>
  <sys:String x:Key="SelectFile">Select a file</sys:String>
  <sys:String x:Key="SelectFolder">Select a folder</sys:String>

  <sys:String x:Key="Models">Local models</sys:String>
  <sys:String x:Key="ModelsDesc">Import GGUF model files for llamafile</sys:String>
  <sys:String x:Key="ChatProvider">Model source</sys:String>
  <sys:String x:Key="ChatProviderDesc">Switch between local llamafile and a remote OpenAI-compatible API</sys:String>
  <sys:String x:Key="ChatProviderLocal">Local</sys:String>
  <sys:String x:Key="ChatProviderRemote">Remote</sys:String>
  <sys:String x:Key="RemoteModels">Remote profiles</sys:String>
  <sys:String x:Key="RemoteModelsDesc">Save multiple API endpoints and models, then switch quickly</sys:String>
  <sys:String x:Key="RemoteName">Profile name</sys:String>
  <sys:String x:Key="RemoteBaseUrl">API base URL</sys:String>
  <sys:String x:Key="RemoteBaseUrlDesc">For example https://api.openai.com or a compatible /v1 endpoint</sys:String>
  <sys:String x:Key="RemoteModelName">Model name</sys:String>
  <sys:String x:Key="RemoteApiKey">API key</sys:String>
  <sys:String x:Key="RemoteApiKeyDesc">Stored in the OS credential store, never as plaintext in the database</sys:String>
  <sys:String x:Key="RemoteApiKeyConfigured">Configured (leave blank to keep)</sys:String>
  <sys:String x:Key="RemoteApiKeyMissing">Not configured</sys:String>
  <sys:String x:Key="NewRemoteModel">New</sys:String>
  <sys:String x:Key="SaveRemoteModel">Save profile</sys:String>
  <sys:String x:Key="DeleteRemoteModel">Delete profile</sys:String>
  <sys:String x:Key="TestRemoteModel">Test connection</sys:String>
  <sys:String x:Key="RemoteNetworkBlocked">Turn on the network switch above before using remote models</sys:String>
  <sys:String x:Key="RemoteReady">Remote model is ready</sys:String>
  <sys:String x:Key="RemoteNotReady">Remote model is not ready</sys:String>
  <sys:String x:Key="RemoteSaved">Remote profile saved</sys:String>
  <sys:String x:Key="RemoteTestOk">Connection succeeded</sys:String>
  <sys:String x:Key="RemoteTestFailed">Connection failed</sys:String>
  <sys:String x:Key="RemoteSaveFailed">Failed to save remote configuration</sys:String>
  <sys:String x:Key="RemoteDeleteFailed">Failed to delete remote configuration</sys:String>
  <sys:String x:Key="OperationFailed">Operation failed, please try again</sys:String>
  <sys:String x:Key="ImportModel">Import model</sys:String>
  <sys:String x:Key="DeleteModel">Delete model</sys:String>
  <sys:String x:Key="ModelDeleted">The model and its local file were deleted</sys:String>
  <sys:String x:Key="UseCurrentModel">Active inference model</sys:String>
  <sys:String x:Key="StartModel">Start</sys:String>
  <sys:String x:Key="StopModel">Stop</sys:String>
  <sys:String x:Key="ModelParameters">Model parameters</sys:String>
  <sys:String x:Key="StartupProfile">Startup profile</sys:String>
  <sys:String x:Key="StartupProfileDesc">The model starts with this profile</sys:String>
  <sys:String x:Key="InferenceDevice">Inference device</sys:String>
  <sys:String x:Key="InferenceDeviceDesc">Prefers discrete GPU, then integrated GPU, then CPU</sys:String>
  <sys:String x:Key="ProfileSection">Profile</sys:String>
  <sys:String x:Key="ProfileName">Profile name</sys:String>
  <sys:String x:Key="ProfileNameDesc">An existing profile with the same name is overwritten</sys:String>
  <sys:String x:Key="ToggleNav">Collapse or expand navigation</sys:String>
  <sys:String x:Key="ToggleSidebar">Collapse or expand session list</sys:String>
  <sys:String x:Key="SaveProfile">Save as profile</sys:String>
  <sys:String x:Key="DeleteProfile">Delete profile</sys:String>
  <sys:String x:Key="ModelRuntime">Runtime</sys:String>
  <sys:String x:Key="ModelSampling">Sampling</sys:String>
  <sys:String x:Key="ModelCompression">Context compression</sys:String>
  <sys:String x:Key="ModelAdvanced">Advanced</sys:String>
  <sys:String x:Key="ContextSize">Context size</sys:String>
  <sys:String x:Key="ContextSizeDesc">llamafile -c; takes effect the next time the model starts</sys:String>
  <sys:String x:Key="Threads">Threads</sys:String>
  <sys:String x:Key="ThreadsDesc">CPU inference threads; takes effect the next time the model starts</sys:String>
  <sys:String x:Key="GpuLayers">GPU layers</sys:String>
  <sys:String x:Key="GpuLayersDesc">In automatic mode, llamafile chooses layers for the model and available VRAM</sys:String>
  <sys:String x:Key="Automatic">Automatic</sys:String>
  <sys:String x:Key="Manual">Manual</sys:String>
  <sys:String x:Key="BatchSize">Batch size</sys:String>
  <sys:String x:Key="BatchSizeDesc">Prompt processing batch size</sys:String>
  <sys:String x:Key="UbatchSize">Ubatch size</sys:String>
  <sys:String x:Key="UbatchSizeDesc">Physical micro-batch size</sys:String>
  <sys:String x:Key="FlashAttention">Flash Attention</sys:String>
  <sys:String x:Key="FlashAttentionDesc">Can reduce GPU memory use when enabled</sys:String>
  <sys:String x:Key="MemoryMap">Memory map</sys:String>
  <sys:String x:Key="MemoryMapDesc">Load weights with mmap</sys:String>
  <sys:String x:Key="MemoryLock">Lock memory</sys:String>
  <sys:String x:Key="MemoryLockDesc">mlock keeps weights from being swapped out</sys:String>
  <sys:String x:Key="Temperature">Temperature</sys:String>
  <sys:String x:Key="TemperatureDesc">Higher values are more random; applies on the next request</sys:String>
  <sys:String x:Key="TopP">Top P</sys:String>
  <sys:String x:Key="TopPDesc">Nucleus sampling threshold</sys:String>
  <sys:String x:Key="TopK">Top K</sys:String>
  <sys:String x:Key="TopKDesc">Sample only from the K most likely tokens</sys:String>
  <sys:String x:Key="MinP">Min P</sys:String>
  <sys:String x:Key="MinPDesc">Minimum probability relative to the top token</sys:String>
  <sys:String x:Key="MaxTokens">Max tokens</sys:String>
  <sys:String x:Key="MaxTokensDesc">Maximum tokens in one reply</sys:String>
  <sys:String x:Key="RepeatPenalty">Repeat penalty</sys:String>
  <sys:String x:Key="RepeatPenaltyDesc">Discourages repeated wording</sys:String>
  <sys:String x:Key="RepeatLastN">Repeat window</sys:String>
  <sys:String x:Key="RepeatLastNDesc">How many recent tokens the penalty looks at</sys:String>
  <sys:String x:Key="Seed">Seed</sys:String>
  <sys:String x:Key="SeedDesc">Leave empty for a random seed each time</sys:String>
  <sys:String x:Key="FrequencyPenalty">Frequency penalty</sys:String>
  <sys:String x:Key="FrequencyPenaltyDesc">Lowers tokens in proportion to how often they appeared</sys:String>
  <sys:String x:Key="PresencePenalty">Presence penalty</sys:String>
  <sys:String x:Key="PresencePenaltyDesc">Lowers tokens after they appear at least once</sys:String>
  <sys:String x:Key="StopSequences">Stop sequences</sys:String>
  <sys:String x:Key="StopSequencesDesc">Comma-separated strings that end generation</sys:String>
  <sys:String x:Key="CompressionEnabled">Summarize long context</sys:String>
  <sys:String x:Key="CompressionEnabledDesc">Only the current session is summarized; other sessions are never read</sys:String>
  <sys:String x:Key="CompressionTrigger">Trigger ratio</sys:String>
  <sys:String x:Key="CompressionTriggerDesc">Summarize when occupancy reaches this fraction of context size; default 0.75</sys:String>
  <sys:String x:Key="KeepRecentMessages">Keep recent messages</sys:String>
  <sys:String x:Key="KeepRecentMessagesDesc">How many latest messages stay uncompressed</sys:String>
  <sys:String x:Key="SummaryMaxTokens">Summary tokens</sys:String>
  <sys:String x:Key="SummaryMaxTokensDesc">Maximum tokens when writing the session summary</sys:String>
  <sys:String x:Key="AdvancedJson">Advanced inference JSON</sys:String>
  <sys:String x:Key="AdvancedJsonDesc">Merged after typed fields. Cannot override model, messages, or stream</sys:String>
  <sys:String x:Key="AdvancedJsonInvalid">Advanced parameters must be a valid JSON object</sys:String>
  <sys:String x:Key="AdvancedJsonReserved">Reserved keys such as model, messages, and stream cannot be overridden</sys:String>
  <sys:String x:Key="ModelStateReady">Model ready</sys:String>
  <sys:String x:Key="ModelStateStarting">Model starting</sys:String>
  <sys:String x:Key="ModelStateStopped">Model stopped</sys:String>
  <sys:String x:Key="ProfileHint">Parameters are stored in profiles and locked while the model runs</sys:String>
  <sys:String x:Key="ProfileSaved">Saved to the profile; it applies the next time you start with it</sys:String>
  <sys:String x:Key="ProfileDeleted">Deleted the profile</sys:String>
  <sys:String x:Key="ProfileNameRequired">Enter a profile name</sys:String>
  <sys:String x:Key="MonitorDesc">Like Task Manager: host usage first, then this app and the model process</sys:String>
  <sys:String x:Key="MonitorRuntime">Runtime status</sys:String>
  <sys:String x:Key="MonitorThreads">threads</sys:String>
  <sys:String x:Key="MonitorSystem">This PC</sys:String>
  <sys:String x:Key="MonitorSystemCpu">System CPU</sys:String>
  <sys:String x:Key="MonitorSystemMemory">System memory</sys:String>
  <sys:String x:Key="MonitorGpu">GPU</sys:String>
  <sys:String x:Key="MonitorPlatform">Control plane</sys:String>
  <sys:String x:Key="MonitorPlatformCpu">Java CPU</sys:String>
  <sys:String x:Key="MonitorPlatformMemory">Java memory</sys:String>
  <sys:String x:Key="MonitorModel">Model process</sys:String>
  <sys:String x:Key="MonitorModelCpu">llamafile CPU</sys:String>
  <sys:String x:Key="MonitorModelMemory">llamafile memory</sys:String>
  <sys:String x:Key="MonitorInference">Inference throughput</sys:String>
  <sys:String x:Key="MonitorWaiting">Waiting for samples…</sys:String>
  <sys:String x:Key="MonitorUnavailable">Monitor data is temporarily unavailable</sys:String>
  <sys:String x:Key="MonitorNoModel">No model selected</sys:String>
  <sys:String x:Key="MonitorModelIdle">Model is not running</sys:String>
  <sys:String x:Key="MonitorGpuUnavailable">NVIDIA GPU metrics are not available</sys:String>
  <sys:String x:Key="MonitorInferenceUnavailable">Inference metrics are not available</sys:String>
  <sys:String x:Key="Hardware">Inference hardware</sys:String>
  <sys:String x:Key="HardwareDesc">Device types are reported by the graphics driver; virtual adapters never appear</sys:String>
  <sys:String x:Key="Recommended">Recommended</sys:String>
  <sys:String x:Key="HwCpu">CPU</sys:String>
  <sys:String x:Key="HwIgpu">IGPU</sys:String>
  <sys:String x:Key="HwGpu">GPU</sys:String>
  <sys:String x:Key="HwOther">Other</sys:String>
  <sys:String x:Key="HwNoVulkan">Vulkan runtime missing</sys:String>
  <sys:String x:Key="HwUnavailable">Unavailable</sys:String>

  <sys:String x:Key="Capabilities">Capabilities</sys:String>
  <sys:String x:Key="Extensions">Extensions</sys:String>
  <sys:String x:Key="CapChat">Basic chat</sys:String>
  <sys:String x:Key="CapChatDesc">Multi-turn conversation with the local model</sys:String>
  <sys:String x:Key="CapContext">Conversation context</sys:String>
  <sys:String x:Key="CapContextDesc">Use message history only within the current session</sys:String>
  <sys:String x:Key="CapRag">Knowledge retrieval</sys:String>
  <sys:String x:Key="CapRagDesc">Search imported local documents before answering</sys:String>
  <sys:String x:Key="CapTools">Tool calling</sys:String>
  <sys:String x:Key="CapToolsDesc">Let the model call registered local tools</sys:String>
  <sys:String x:Key="CapMcp">MCP</sys:String>
  <sys:String x:Key="CapMcpDesc">Use capabilities exposed by MCP servers</sys:String>
  <sys:String x:Key="CapSkills">Skills</sys:String>
  <sys:String x:Key="CapSkillsDesc">Load preset prompts and flows per scenario</sys:String>
  <sys:String x:Key="CapNetwork">Network</sys:String>
  <sys:String x:Key="CapNetworkDesc">Allow tools and MCP servers to reach the network</sys:String>
  <sys:String x:Key="CapNetworkBlocked">Turn on Network on the General page first</sys:String>
  <sys:String x:Key="CapEmbedding">Embedding</sys:String>
  <sys:String x:Key="CapEmbeddingDesc">Build vector indexes for the local knowledge base</sys:String>
  <sys:String x:Key="CapGraphRag">GraphRAG</sys:String>
  <sys:String x:Key="CapGraphRagDesc">Extract entity relations with a remote model for cross-passage questions</sys:String>
  <sys:String x:Key="CapHyde">HyDE</sys:String>
  <sys:String x:Key="CapHydeDesc">Generate a hypothetical answer with a remote model to improve short-query recall</sys:String>
  <sys:String x:Key="CapRemoteOnly">Switch to a remote model on the General page first</sys:String>

  <sys:String x:Key="Rag">Knowledge</sys:String>
  <sys:String x:Key="RagDesc">Imported documents are chunked and indexed locally</sys:String>
  <sys:String x:Key="RagDocuments">Knowledge documents</sys:String>
  <sys:String x:Key="ImportDocument">Import document</sys:String>
  <sys:String x:Key="EmbeddingStatusReady">Embedding model is running</sys:String>
  <sys:String x:Key="EmbeddingStatusIdle">Embedding model is available and starts on import or search</sys:String>
  <sys:String x:Key="EmbeddingStatusMissing">BGE-M3 not found. Place it under models/embedding in the user data directory</sys:String>
  <sys:String x:Key="RerankStatusReady">Reranker is running</sys:String>
  <sys:String x:Key="RerankStatusMissing">Reranker not found; retrieval will use hybrid ranking only</sys:String>
  <sys:String x:Key="Tools">Tools</sys:String>
  <sys:String x:Key="ToolsDesc">Registered local tools</sys:String>
  <sys:String x:Key="Mcp">MCP servers</sys:String>
  <sys:String x:Key="McpDesc">Configured MCP servers</sys:String>
  <sys:String x:Key="Skills">Skills</sys:String>
  <sys:String x:Key="SkillsDesc">Installed skill packages</sys:String>
  <sys:String x:Key="EmptyList">Nothing here yet</sys:String>

  <sys:String x:Key="ImportPlugin">Import plugin package</sys:String>
  <sys:String x:Key="ImportSkill">Import skill</sys:String>
  <sys:String x:Key="PluginReady">Ready</sys:String>
  <sys:String x:Key="PluginStopped">Stopped</sys:String>
  <sys:String x:Key="PluginWaitingDependency">Waiting for capability</sys:String>
  <sys:String x:Key="Enable">Enable</sys:String>
