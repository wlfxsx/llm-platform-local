<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
  <sys:String x:Key="AppTitle">本地 AI 平台</sys:String>
  <sys:String x:Key="TrayChat">对话</sys:String>
  <sys:String x:Key="TraySettings">设置</sys:String>
  <sys:String x:Key="TrayExit">退出</sys:String>

  <sys:String x:Key="Send">发送</sys:String>
  <sys:String x:Key="InputPlaceholder">输入消息，回车发送，Ctrl 或 Shift+回车换行</sys:String>
  <sys:String x:Key="EditMessage">修改</sys:String>
  <sys:String x:Key="RetractMessage">撤回</sys:String>
  <sys:String x:Key="ChatFailed">请求失败，请稍后重试</sys:String>
  <sys:String x:Key="ChatFailedLocal">请求失败，请先导入并启动本地模型</sys:String>
  <sys:String x:Key="ChatFailedRemote">请求失败，请检查远程配置与网络</sys:String>
  <sys:String x:Key="ChatFailedRemoteKey">请求失败，请检查远程 API Key</sys:String>
  <sys:String x:Key="ChatFailedNetwork">请求失败，请先打开联网总开关</sys:String>
  <sys:String x:Key="StatusGenerating">正在生成…</sys:String>
  <sys:String x:Key="Sessions">会话</sys:String>
  <sys:String x:Key="NewSession">新建会话</sys:String>
  <sys:String x:Key="DeleteSession">删除会话</sys:String>
  <sys:String x:Key="UntitledSession">未命名会话</sys:String>

  <sys:String x:Key="ServerStarting">正在启动本地服务…</sys:String>
  <sys:String x:Key="ServerReady">本地服务已就绪</sys:String>
  <sys:String x:Key="ServerFailed">无法启动本地服务</sys:String>

  <sys:String x:Key="TabGeneral">常规</sys:String>
  <sys:String x:Key="TabModels">模型</sys:String>
  <sys:String x:Key="TabMonitor">监控</sys:String>
  <sys:String x:Key="TabCapabilities">能力</sys:String>
  <sys:String x:Key="TabData">数据</sys:String>
  <sys:String x:Key="TabPlugins">插件</sys:String>

  <sys:String x:Key="Language">语言</sys:String>
  <sys:String x:Key="LanguageDesc">切换界面与新消息使用的语言</sys:String>
  <sys:String x:Key="LanguageChinese">中文</sys:String>
  <sys:String x:Key="LanguageEnglish">English</sys:String>
  <sys:String x:Key="Theme">主题</sys:String>
  <sys:String x:Key="ThemeDesc">浅色、深色或跟随系统设置</sys:String>
  <sys:String x:Key="ThemeLight">浅色</sys:String>
  <sys:String x:Key="ThemeDark">深色</sys:String>
  <sys:String x:Key="ThemeSystem">跟随系统</sys:String>
  <sys:String x:Key="Network">允许 AI 联网</sys:String>
  <sys:String x:Key="NetworkDesc">关闭后所有推理与检索都在本机完成</sys:String>
  <sys:String x:Key="Refresh">刷新</sys:String>
  <sys:String x:Key="SelectFile">选择文件</sys:String>
  <sys:String x:Key="SelectFolder">选择文件夹</sys:String>

  <sys:String x:Key="Models">本地模型</sys:String>
  <sys:String x:Key="ModelsDesc">导入 GGUF 模型文件供 llamafile 加载</sys:String>
  <sys:String x:Key="ChatProvider">模型来源</sys:String>
  <sys:String x:Key="ChatProviderDesc">在本地 llamafile 与远程 OpenAI 兼容服务之间切换</sys:String>
  <sys:String x:Key="ChatProviderLocal">本地</sys:String>
  <sys:String x:Key="ChatProviderRemote">远程</sys:String>
  <sys:String x:Key="RemoteModels">远程配置</sys:String>
  <sys:String x:Key="RemoteModelsDesc">可保存多套 API 地址与模型并快速切换</sys:String>
  <sys:String x:Key="RemoteName">配置名称</sys:String>
  <sys:String x:Key="RemoteBaseUrl">API 地址</sys:String>
  <sys:String x:Key="RemoteBaseUrlDesc">例如 https://api.openai.com 或带 /v1 的兼容地址</sys:String>
  <sys:String x:Key="RemoteModelName">模型名</sys:String>
  <sys:String x:Key="RemoteApiKey">API Key</sys:String>
  <sys:String x:Key="RemoteApiKeyDesc">保存在系统凭据库，不会明文写入数据库</sys:String>
  <sys:String x:Key="RemoteApiKeyConfigured">已配置（留空表示不修改）</sys:String>
  <sys:String x:Key="RemoteApiKeyMissing">尚未配置</sys:String>
  <sys:String x:Key="NewRemoteModel">新建</sys:String>
  <sys:String x:Key="SaveRemoteModel">保存配置</sys:String>
  <sys:String x:Key="DeleteRemoteModel">删除配置</sys:String>
  <sys:String x:Key="TestRemoteModel">测试连接</sys:String>
  <sys:String x:Key="RemoteNetworkBlocked">请先打开上方的联网总开关，才能使用远程模型</sys:String>
  <sys:String x:Key="RemoteReady">远程模型已就绪</sys:String>
  <sys:String x:Key="RemoteNotReady">远程模型未就绪</sys:String>
  <sys:String x:Key="RemoteSaved">远程配置已保存</sys:String>
  <sys:String x:Key="RemoteTestOk">连接成功</sys:String>
  <sys:String x:Key="RemoteTestFailed">连接失败</sys:String>
  <sys:String x:Key="RemoteSaveFailed">远程配置保存失败</sys:String>
  <sys:String x:Key="RemoteDeleteFailed">远程配置删除失败</sys:String>
  <sys:String x:Key="OperationFailed">操作失败，请稍后重试</sys:String>
  <sys:String x:Key="ImportModel">导入模型</sys:String>
  <sys:String x:Key="DeleteModel">删除模型</sys:String>
  <sys:String x:Key="ModelDeleted">模型及其本地文件已删除</sys:String>
  <sys:String x:Key="UseCurrentModel">当前推理模型</sys:String>
  <sys:String x:Key="StartModel">启动</sys:String>
  <sys:String x:Key="StopModel">停止</sys:String>
  <sys:String x:Key="ModelParameters">模型参数</sys:String>
  <sys:String x:Key="StartupProfile">启动预设</sys:String>
  <sys:String x:Key="StartupProfileDesc">按所选预设的参数启动模型</sys:String>
  <sys:String x:Key="InferenceDevice">推理硬件</sys:String>
  <sys:String x:Key="InferenceDeviceDesc">默认优先独立显卡，其次核显，最后 CPU</sys:String>
  <sys:String x:Key="ProfileSection">预设</sys:String>
  <sys:String x:Key="ProfileName">预设名称</sys:String>
  <sys:String x:Key="ProfileNameDesc">同名预设将被覆盖</sys:String>
  <sys:String x:Key="ToggleNav">收起或展开导航</sys:String>
  <sys:String x:Key="ToggleSidebar">收起或展开会话列表</sys:String>
  <sys:String x:Key="SaveProfile">保存为预设</sys:String>
  <sys:String x:Key="DeleteProfile">删除预设</sys:String>
  <sys:String x:Key="ModelRuntime">运行</sys:String>
  <sys:String x:Key="ModelSampling">采样</sys:String>
  <sys:String x:Key="ModelCompression">上下文压缩</sys:String>
  <sys:String x:Key="ModelAdvanced">高级参数</sys:String>
  <sys:String x:Key="ContextSize">上下文长度</sys:String>
  <sys:String x:Key="ContextSizeDesc">llamafile 的 -c 参数，下次启动后生效</sys:String>
  <sys:String x:Key="Threads">线程数</sys:String>
  <sys:String x:Key="ThreadsDesc">CPU 推理线程，下次启动后生效</sys:String>
  <sys:String x:Key="GpuLayers">GPU 层数</sys:String>
  <sys:String x:Key="GpuLayersDesc">自动时由 llamafile 按模型和显存决定卸载层数</sys:String>
  <sys:String x:Key="Automatic">自动</sys:String>
  <sys:String x:Key="Manual">手动</sys:String>
  <sys:String x:Key="BatchSize">批大小</sys:String>
  <sys:String x:Key="BatchSizeDesc">提示处理批大小</sys:String>
  <sys:String x:Key="UbatchSize">微批大小</sys:String>
  <sys:String x:Key="UbatchSizeDesc">物理微批大小</sys:String>
  <sys:String x:Key="FlashAttention">Flash Attention</sys:String>
  <sys:String x:Key="FlashAttentionDesc">启用后可降低显存占用</sys:String>
  <sys:String x:Key="MemoryMap">内存映射</sys:String>
  <sys:String x:Key="MemoryMapDesc">用 mmap 加载权重</sys:String>
  <sys:String x:Key="MemoryLock">锁定内存</sys:String>
  <sys:String x:Key="MemoryLockDesc">mlock 防止权重被换出</sys:String>
  <sys:String x:Key="Temperature">温度</sys:String>
  <sys:String x:Key="TemperatureDesc">越高越随机，下一请求立即生效</sys:String>
  <sys:String x:Key="TopP">Top P</sys:String>
  <sys:String x:Key="TopPDesc">核采样概率阈值</sys:String>
  <sys:String x:Key="TopK">Top K</sys:String>
  <sys:String x:Key="TopKDesc">只从概率最高的 K 个 token 采样</sys:String>
  <sys:String x:Key="MinP">Min P</sys:String>
  <sys:String x:Key="MinPDesc">相对最高概率的下限</sys:String>
  <sys:String x:Key="MaxTokens">最大生成 Token</sys:String>
  <sys:String x:Key="MaxTokensDesc">单次回复的长度上限</sys:String>
  <sys:String x:Key="RepeatPenalty">重复惩罚</sys:String>
  <sys:String x:Key="RepeatPenaltyDesc">抑制重复用词</sys:String>
  <sys:String x:Key="RepeatLastN">重复窗口</sys:String>
  <sys:String x:Key="RepeatLastNDesc">重复惩罚回看的 token 数</sys:String>
  <sys:String x:Key="Seed">随机种子</sys:String>
  <sys:String x:Key="SeedDesc">留空表示每次随机</sys:String>
  <sys:String x:Key="FrequencyPenalty">频率惩罚</sys:String>
  <sys:String x:Key="FrequencyPenaltyDesc">按出现次数降低重复</sys:String>
  <sys:String x:Key="PresencePenalty">存在惩罚</sys:String>
  <sys:String x:Key="PresencePenaltyDesc">只要出现过就降低概率</sys:String>
  <sys:String x:Key="StopSequences">停止词</sys:String>
  <sys:String x:Key="StopSequencesDesc">用逗号分隔，命中后停止生成</sys:String>
  <sys:String x:Key="CompressionEnabled">启用摘要压缩</sys:String>
  <sys:String x:Key="CompressionEnabledDesc">只压缩当前会话，不会读取其他会话</sys:String>
  <sys:String x:Key="CompressionTrigger">触发占用率</sys:String>
  <sys:String x:Key="CompressionTriggerDesc">达到上下文长度的该比例后生成摘要，默认 0.75</sys:String>
  <sys:String x:Key="KeepRecentMessages">保留最近消息</sys:String>
  <sys:String x:Key="KeepRecentMessagesDesc">摘要后仍按原文送入模型的条数</sys:String>
  <sys:String x:Key="SummaryMaxTokens">摘要长度</sys:String>
  <sys:String x:Key="SummaryMaxTokensDesc">生成会话摘要时的最大 Token 数</sys:String>
  <sys:String x:Key="AdvancedJson">高级推理参数</sys:String>
  <sys:String x:Key="AdvancedJsonDesc">JSON 对象会在强类型字段之后合并，不能覆盖 model、messages、stream</sys:String>
  <sys:String x:Key="AdvancedJsonInvalid">高级参数必须是合法 JSON 对象</sys:String>
  <sys:String x:Key="AdvancedJsonReserved">不能覆盖 model、messages、stream 等保留字段</sys:String>
  <sys:String x:Key="ModelStateReady">模型已就绪</sys:String>
  <sys:String x:Key="ModelStateStarting">模型启动中</sys:String>
  <sys:String x:Key="ModelStateStopped">模型未运行</sys:String>
  <sys:String x:Key="ProfileHint">参数保存为预设，模型运行时不可修改</sys:String>
  <sys:String x:Key="ProfileSaved">已保存到预设，下次启动该预设时生效</sys:String>
  <sys:String x:Key="ProfileDeleted">已删除预设</sys:String>
  <sys:String x:Key="ProfileNameRequired">请填写预设名称</sys:String>
  <sys:String x:Key="MonitorDesc">类似任务管理器：先看整机占用，再看本平台与模型进程</sys:String>
  <sys:String x:Key="MonitorRuntime">运行状态</sys:String>
  <sys:String x:Key="MonitorThreads">线程</sys:String>
  <sys:String x:Key="MonitorSystem">整机资源</sys:String>
  <sys:String x:Key="MonitorSystemCpu">系统 CPU</sys:String>
  <sys:String x:Key="MonitorSystemMemory">系统内存</sys:String>
  <sys:String x:Key="MonitorGpu">GPU</sys:String>
  <sys:String x:Key="MonitorPlatform">控制面进程</sys:String>
  <sys:String x:Key="MonitorPlatformCpu">Java CPU</sys:String>
  <sys:String x:Key="MonitorPlatformMemory">Java 内存</sys:String>
  <sys:String x:Key="MonitorModel">模型进程</sys:String>
  <sys:String x:Key="MonitorModelCpu">llamafile CPU</sys:String>
  <sys:String x:Key="MonitorModelMemory">llamafile 内存</sys:String>
  <sys:String x:Key="MonitorInference">推理吞吐</sys:String>
  <sys:String x:Key="MonitorWaiting">等待采样…</sys:String>
  <sys:String x:Key="MonitorUnavailable">暂时无法读取监控数据</sys:String>
  <sys:String x:Key="MonitorNoModel">未选择模型</sys:String>
  <sys:String x:Key="MonitorModelIdle">模型未运行</sys:String>
  <sys:String x:Key="MonitorGpuUnavailable">未检测到可用的 NVIDIA 监控数据</sys:String>
  <sys:String x:Key="MonitorInferenceUnavailable">推理指标暂不可用</sys:String>
  <sys:String x:Key="Hardware">推理硬件</sys:String>
  <sys:String x:Key="HardwareDesc">设备类型由显卡驱动上报，虚拟显示适配器不会出现在列表中</sys:String>
  <sys:String x:Key="Recommended">推荐</sys:String>
  <sys:String x:Key="HwCpu">CPU</sys:String>
  <sys:String x:Key="HwIgpu">IGPU</sys:String>
  <sys:String x:Key="HwGpu">GPU</sys:String>
  <sys:String x:Key="HwOther">其他</sys:String>
  <sys:String x:Key="HwNoVulkan">缺少 Vulkan 运行时</sys:String>
  <sys:String x:Key="HwUnavailable">不可用</sys:String>

  <sys:String x:Key="Capabilities">能力开关</sys:String>
  <sys:String x:Key="Extensions">扩展</sys:String>
  <sys:String x:Key="CapChat">基础对话</sys:String>
  <sys:String x:Key="CapChatDesc">与本地模型进行多轮对话</sys:String>
  <sys:String x:Key="CapContext">多轮上下文</sys:String>
  <sys:String x:Key="CapContextDesc">仅在当前会话中携带历史消息，开始新会话后不再使用</sys:String>
  <sys:String x:Key="CapRag">知识库检索</sys:String>
  <sys:String x:Key="CapRagDesc">回答前检索已导入的本地文档</sys:String>
  <sys:String x:Key="CapTools">工具调用</sys:String>
  <sys:String x:Key="CapToolsDesc">允许模型调用已注册的本地工具</sys:String>
  <sys:String x:Key="CapMcp">MCP</sys:String>
  <sys:String x:Key="CapMcpDesc">接入 MCP 服务提供的外部能力</sys:String>
  <sys:String x:Key="CapSkills">技能</sys:String>
  <sys:String x:Key="CapSkillsDesc">按场景加载预置提示与流程</sys:String>
  <sys:String x:Key="CapNetwork">联网</sys:String>
  <sys:String x:Key="CapNetworkDesc">允许工具与 MCP 访问网络</sys:String>
  <sys:String x:Key="CapNetworkBlocked">需要先在“常规”页打开“联网”总开关</sys:String>
  <sys:String x:Key="CapEmbedding">向量化</sys:String>
  <sys:String x:Key="CapEmbeddingDesc">为本地知识库生成向量索引</sys:String>

  <sys:String x:Key="Rag">知识库</sys:String>
  <sys:String x:Key="RagDesc">导入的文档会切分并建立本地索引</sys:String>
  <sys:String x:Key="ImportDocument">导入文档</sys:String>
  <sys:String x:Key="Tools">工具</sys:String>
  <sys:String x:Key="ToolsDesc">已注册的本地工具</sys:String>
  <sys:String x:Key="Mcp">MCP 服务</sys:String>
  <sys:String x:Key="McpDesc">已配置的 MCP 服务端</sys:String>
  <sys:String x:Key="Skills">技能</sys:String>
  <sys:String x:Key="SkillsDesc">已安装的技能包</sys:String>
  <sys:String x:Key="EmptyList">暂无内容</sys:String>

  <sys:String x:Key="ImportPlugin">导入插件包</sys:String>
