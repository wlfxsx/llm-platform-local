  <sys:String x:Key="PluginReady">已就绪</sys:String>
  <sys:String x:Key="PluginStopped">已停用</sys:String>
  <sys:String x:Key="PluginWaitingDependency">等待依赖能力</sys:String>
  <sys:String x:Key="Enable">启用</sys:String>
